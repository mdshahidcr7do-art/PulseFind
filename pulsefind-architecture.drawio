          <mxGeometry x="1250" y="115" width="340" height="915" as="geometry" />
        </mxCell>

        <!-- Service: Browser Geolocation -->
        <mxCell id="ext-geo" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Browser Geolocation API&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;W3C Geolocation Standard&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; &lt;b&gt;navigator.geolocation&lt;/b&gt;&lt;br&gt;&amp;bull; Obtains user's live lat/lng coordinates&lt;br&gt;&amp;bull; Powers client-side Haversine distance calculations&lt;br&gt;&amp;bull; Zero external API calls / Zero quota usage&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-external">
          <mxGeometry x="15" y="50" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- Service: OpenStreetMap -->
        <mxCell id="ext-osm" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;OpenStreetMap (OSM)&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#059669&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;Free Map Tile Server&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; &lt;b&gt;openstreetmap.org&lt;/b&gt; standard raster tiles&lt;br&gt;&amp;bull; Fetched directly by Leaflet.js in browser&lt;br&gt;&amp;bull; Open-source global geospatial basemap&lt;br&gt;&amp;bull; No API key or billing required&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-external">
          <mxGeometry x="15" y="195" width="310" height="120" as="geometry" />
        </mxCell>

        <!-- Service: Google Maps Directions -->
