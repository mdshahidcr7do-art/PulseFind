        <!-- Actor: Medicine Seeker -->
        <mxCell id="actor-med-seeker" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Medicine Seeker / Patient&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px;&quot;&gt;Public User (No login required)&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:11px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; Searches medicines by name&lt;br&gt;&amp;bull; Shares current geolocation&lt;br&gt;&amp;bull; Views nearest verified pharmacies&lt;br&gt;&amp;bull; Calls / WhatsApps pharmacy&lt;br&gt;&amp;bull; Opens Google Maps directions&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;shadow=1;arcSize=6;spacing=8;" vertex="1" parent="layer-users">
          <mxGeometry x="15" y="50" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Actor: Blood Seeker -->
        <mxCell id="actor-blood-seeker" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Blood Seeker / Attendant&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:11px;&quot;&gt;Emergency Request Creator&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:11px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; Filters donors by blood group&lt;br&gt;&amp;bull; Checks live availability &amp;amp; distance&lt;br&gt;&amp;bull; Creates emergency blood request&lt;br&gt;&amp;bull; Direct calls verified donors&lt;br&gt;&amp;bull; Reviews donor responses&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#EF4444;shadow=1;arcSize=6;spacing=8;" vertex="1" parent="layer-users">
          <mxGeometry x="15" y="225" width="240" height="150" as="geometry" />
        </mxCell>

        <!-- Actor: Pharmacy Provider -->
        <mxCell id="actor-pharmacy" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Pharmacy Provider&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#059669&quot; style=&quot;font-size:11px; font-weight:bold;&quot;&gt;Registered Account&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:11px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; Registers with email &amp;amp; phone&lt;br&gt;&amp;bull; Completes native email verification&lt;br&gt;&amp;bull; Completes store profile &amp;amp; location&lt;br&gt;&amp;bull; Real-time inventory CRUD&lt;br&gt;&amp;bull; Toggles stock status (In/Low/Out)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;shadow=1;arcSize=6;spacing=8;" vertex="1" parent="layer-users">
          <mxGeometry x="15" y="400" width="240" height="155" as="geometry" />
        </mxCell>

        <!-- Actor: Blood Donor -->
        <mxCell id="actor-donor" value="&lt;b style=&quot;font-size:13px; color:#0F172A;&quot;&gt;Blood Donor&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#DC2626&quot; style=&quot;font-size:11px; font-weight:bold;&quot;&gt;Registered Account&lt;/font&gt;&lt;hr style=&quot;margin:4px 0;&quot;&gt;&lt;div style=&quot;text-align:left; font-size:11px; color:#334155; line-height:1.4;&quot;&gt;&amp;bull; Registers with blood group &amp;amp; phone&lt;br&gt;&amp;bull; Completes native email verification&lt;br&gt;&amp;bull; Sets live donation availability toggle&lt;br&gt;&amp;bull; Views matching emergency alerts&lt;br&gt;&amp;bull; Responds &quot;I Can Help&quot; with 1-click&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;shadow=1;arcSize=6;spacing=8;" vertex="1" parent="layer-users">
          <mxGeometry x="15" y="580" width="240" height="155" as="geometry" />
        </mxCell>

        <!-- Actor Note -->
        <mxCell id="actor-note" value="&lt;b style=&quot;font-size:11px; color:#0F172A;&quot;&gt;Role Separation &amp;amp; Guarding&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;Seekers access public tools instantly without login. Providers &amp;amp; donors require verified email accounts.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#CBD5E1;arcSize=6;spacing=6;" vertex="1" parent="layer-users">
          <mxGeometry x="15" y="755" width="240" height="75" as="geometry" />
