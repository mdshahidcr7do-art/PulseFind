        <!-- Module: Search & Map Engine -->
        <mxCell id="mod-search" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Search &amp;amp; Discovery Engine&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#0D9488&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;search.html (Tabs: Medicine | Blood)&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; Medicine query matching against pharmacy inventory&lt;br&gt;&amp;bull; Blood group filter &amp;amp; availability query&lt;br&gt;&amp;bull; &lt;b&gt;Client-side Haversine sorting&lt;/b&gt; (distance in km)&lt;br&gt;&amp;bull; Verified badge filter (&lt;b&gt;emailVerified == true&lt;/b&gt;)&lt;br&gt;&amp;bull; Emergency blood request modal with Firestore writer&lt;br&gt;&amp;bull; Detail modal &amp;amp; action triggers (Call / WhatsApp / Maps)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDFA;strokeColor=#0D9488;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="130" width="380" height="130" as="geometry" />
        </mxCell>

        <!-- Sub-module: Leaflet Map Component -->
        <mxCell id="mod-map" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Interactive Map Component&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#2563EB&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;Leaflet.js Map Controller&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; User location pulse marker (Blue)&lt;br&gt;&amp;bull; Dynamic pharmacy markers (Emerald/Stock indicator)&lt;br&gt;&amp;bull; Dynamic blood donor markers (Red/Available indicator)&lt;br&gt;&amp;bull; Custom interactive popups with direct action buttons&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#3B82F6;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="270" width="380" height="95" as="geometry" />
        </mxCell>

        <!-- Module: Authentication & Native Verification Flow -->
        <mxCell id="mod-auth" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Auth &amp;amp; Email Verification Module&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;login.html &amp;bull; verify-email.html&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; Pharmacy &amp;amp; Donor tabbed registration &amp;amp; login&lt;br&gt;&amp;bull; Triggers &lt;b&gt;sendEmailVerification()&lt;/b&gt; on signup&lt;br&gt;&amp;bull; Dedicated verification screen with masked email&lt;br&gt;&amp;bull; Real-time status polling via &lt;b&gt;user.reload()&lt;/b&gt;&lt;br&gt;&amp;bull; Resend link cooldown timer (30s)&lt;br&gt;&amp;bull; Route guards &amp;amp; signOut() handler&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="375" width="380" height="125" as="geometry" />
        </mxCell>

        <!-- Module: Profile Onboarding -->
        <mxCell id="mod-onboarding" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Profile Onboarding &amp;amp; Geocoding&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot; style=&quot;font-size:10px;&quot;&gt;pharmacy-profile.html &amp;bull; donor-profile.html&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; Guarded by &lt;b&gt;emailVerified == true&lt;/b&gt;&lt;br&gt;&amp;bull; Captures coordinates (lat/lng), address, city, timing&lt;br&gt;&amp;bull; Donor blood group, availability &amp;amp; donation history&lt;br&gt;&amp;bull; Atomically marks &lt;b&gt;profileComplete: true&lt;/b&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="510" width="380" height="100" as="geometry" />
        </mxCell>

        <!-- Module: Pharmacy Dashboard -->
        <mxCell id="mod-pharm-dash" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Pharmacy Operations Dashboard&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#059669&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;provider-dashboard.html&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; Real-time inventory table via &lt;b&gt;onSnapshot()&lt;/b&gt;&lt;br&gt;&amp;bull; Add medicine, update stock status, adjust price/qty&lt;br&gt;&amp;bull; Stock counters (Total, In Stock, Low, Out of Stock)&lt;br&gt;&amp;bull; Store status banner with verified trust indicator&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="620" width="380" height="110" as="geometry" />
        </mxCell>

        <!-- Module: Donor Dashboard -->
