          <mxGeometry x="15" y="740" width="380" height="110" as="geometry" />
        </mxCell>

        <!-- Frontend SDK & Architecture Footnote -->
        <mxCell id="front-tech-badge" value="&lt;b style=&quot;font-size:10px; color:#334155;&quot;&gt;Client Architecture:&lt;/b&gt; Pure SPA/MPA Static Pages &amp;bull; Firebase JS SDK v10.12.2 Compat &amp;bull; Leaflet.js v1.9.4" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#CBD5E1;arcSize=4;spacing=4;" vertex="1" parent="layer-frontend">
          <mxGeometry x="15" y="860" width="380" height="35" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER 3: FIREBASE BACKEND / DATA ==================== -->
        <mxCell id="layer-firebase" value="3. FIREBASE BACKEND &amp; DATA PLATFORM (Spark Free Tier)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#F59E0B;fontColor=#0F172A;fontStyle=1;fontSize=14;fontFamily=Segoe UI;startSize=36;rounded=1;arcSize=4;shadow=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="115" width="470" height="915" as="geometry" />
