        <!-- Service 1: Firebase Hosting -->
        <mxCell id="fb-hosting" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Firebase Hosting&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#D97706&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;Global CDN Static Hosting&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#475569; margin-top:2px;&quot;&gt;&amp;bull; Serves HTML, CSS, client-side JS &amp;amp; assets&lt;br&gt;&amp;bull; Configured in &lt;b&gt;firebase.json&lt;/b&gt; (public: &quot;.&quot;)&lt;br&gt;&amp;bull; Free custom domain &amp;amp; automatic SSL&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-firebase">
          <mxGeometry x="15" y="45" width="440" height="75" as="geometry" />
        </mxCell>

        <!-- Service 2: Firebase Authentication -->
        <mxCell id="fb-auth" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Firebase Authentication&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#7C3AED&quot; style=&quot;font-size:10px; font-weight:bold;&quot;&gt;Identity &amp;amp; Native Email Verification Service&lt;/font&gt;&lt;div style=&quot;text-align:left; font-size:10px; color:#334155; margin-top:3px;&quot;&gt;&amp;bull; &lt;b&gt;createUserWithEmailAndPassword&lt;/b&gt; / &lt;b&gt;signInWithEmailAndPassword&lt;/b&gt;&lt;br&gt;&amp;bull; &lt;b&gt;sendEmailVerification()&lt;/b&gt;: Sends secure Firebase verification link to email&lt;br&gt;&amp;bull; &lt;b&gt;user.reload()&lt;/b&gt;: Live check for &lt;b&gt;currentUser.emailVerified == true&lt;/b&gt;&lt;br&gt;&amp;bull; Client session persistence &amp;amp; token management (No backend code required)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#8B5CF6;shadow=1;arcSize=6;spacing=6;" vertex="1" parent="layer-firebase">
          <mxGeometry x="15" y="130" width="440" height="100" as="geometry" />
        </mxCell>

        <!-- Service 3: Cloud Firestore Container -->
        <mxCell id="fb-firestore" value="&lt;b style=&quot;font-size:12px; color:#0F172A;&quot;&gt;Cloud Firestore (NoSQL Document Database)&lt;/b&gt;" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#F59E0B;fontColor=#0F172A;fontStyle=1;fontSize=12;fontFamily=Segoe UI;startSize=26;rounded=1;arcSize=4;shadow=1;" vertex="1" parent="layer-firebase">
          <mxGeometry x="15" y="240" width="440" height="520" as="geometry" />
        </mxCell>

        <!-- Collection: users -->
        <mxCell id="coll-users" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Collection: users/{uid}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; role: &quot;pharmacy&quot; | &quot;donor&quot;&lt;br&gt;&amp;bull; name, email, phone, area&lt;br&gt;&amp;bull; emailVerified: boolean (synced on verify)&lt;br&gt;&amp;bull; profileComplete: boolean&lt;br&gt;&amp;bull; createdAt: Timestamp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="10" y="32" width="200" height="105" as="geometry" />
        </mxCell>

        <!-- Collection: pharmacies -->
        <mxCell id="coll-pharmacies" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Collection: pharmacies/{uid}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; name, phone, whatsapp, address&lt;br&gt;&amp;bull; area, city, hours, licenseNumber&lt;br&gt;&amp;bull; lat: number, lng: number&lt;br&gt;&amp;bull; emailVerified: boolean&lt;br&gt;&amp;bull; profileComplete: boolean&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="220" y="32" width="210" height="105" as="geometry" />
        </mxCell>

        <!-- Collection: inventory -->
        <mxCell id="coll-inventory" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Collection: inventory/{itemId}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; pharmacyId: &quot;{uid}&quot; (foreign key)&lt;br&gt;&amp;bull; pharmacyName: string&lt;br&gt;&amp;bull; medicineName / name: string (indexed)&lt;br&gt;&amp;bull; category, price, quantity&lt;br&gt;&amp;bull; status: &quot;in_stock&quot;|&quot;low_stock&quot;|&quot;out_of_stock&quot;&lt;br&gt;&amp;bull; updatedAt: Timestamp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0FDF4;strokeColor=#10B981;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="10" y="145" width="200" height="120" as="geometry" />
        </mxCell>

        <!-- Collection: donors -->
        <mxCell id="coll-donors" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Collection: donors/{uid}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; name, phone, bloodGroup (A+, O-, etc.)&lt;br&gt;&amp;bull; available: boolean (live toggle)&lt;br&gt;&amp;bull; area, city, lat: number, lng: number&lt;br&gt;&amp;bull; emailVerified: boolean&lt;br&gt;&amp;bull; profileComplete: boolean&lt;br&gt;&amp;bull; lastDonated: string | null&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF2F2;strokeColor=#EF4444;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="220" y="145" width="210" height="120" as="geometry" />
        </mxCell>

        <!-- Collection: blood_requests -->
        <mxCell id="coll-blood-requests" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Collection: blood_requests/{reqId}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; patientName, hospital, bloodGroup&lt;br&gt;&amp;bull; units, urgency (&quot;emergency&quot;|&quot;critical&quot;|&quot;standard&quot;)&lt;br&gt;&amp;bull; contactPhone, additionalNotes&lt;br&gt;&amp;bull; area, lat: number, lng: number&lt;br&gt;&amp;bull; status: &quot;open&quot; | &quot;fulfilled&quot; | &quot;closed&quot;&lt;br&gt;&amp;bull; createdAt: Timestamp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="10" y="275" width="200" height="135" as="geometry" />
        </mxCell>

        <!-- Subcollection: responses -->
        <mxCell id="coll-responses" value="&lt;b style=&quot;color:#0F172A; font-size:11px;&quot;&gt;Subcollection: {reqId}/responses/{uid}&lt;/b&gt;&lt;div style=&quot;text-align:left; font-size:9px; color:#475569; font-family:Consolas, monospace; margin-top:2px;&quot;&gt;&amp;bull; donorUid: &quot;{uid}&quot;&lt;br&gt;&amp;bull; donorName, donorPhone, bloodGroup&lt;br&gt;&amp;bull; message, status: &quot;offered&quot; | &quot;accepted&quot;&lt;br&gt;&amp;bull; respondedAt: Timestamp&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#F43F5E;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="220" y="275" width="210" height="135" as="geometry" />
        </mxCell>

        <!-- Firestore Security & Indexing Note -->
        <mxCell id="fb-security-note" value="&lt;b style=&quot;font-size:10px; color:#0F172A;&quot;&gt;Firestore Security Rules &amp;amp; Indexing Strategy:&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#475569&quot; style=&quot;font-size:9px;&quot;&gt;&amp;bull; Read-only public access to inventory, pharmacies, and available donors&lt;br&gt;&amp;bull; Write permissions restricted to authenticated &amp;amp; verified owners (auth.uid == resource.data.pharmacyId/uid)&lt;br&gt;&amp;bull; Single-field &amp;amp; composite indexes on (medicineName), (bloodGroup, available)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;arcSize=4;spacing=4;" vertex="1" parent="fb-firestore">
          <mxGeometry x="10" y="420" width="420" height="85" as="geometry" />
        </mxCell>

        <!-- Security Guard Callout -->
        <mxCell id="fb-guard-callout" value="&lt;b style=&quot;font-size:11px; color:#065F46;&quot;&gt;Security &amp;amp; Verification Enforcement&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#047857&quot; style=&quot;font-size:10px;&quot;&gt;&amp;bull; &lt;b&gt;Route Guarding:&lt;/b&gt; Unverified accounts cannot access dashboards / profiles.&lt;br&gt;&amp;bull; &lt;b&gt;Public Search Filter:&lt;/b&gt; Only records with &lt;b&gt;emailVerified == true&lt;/b&gt; are shown in public results with trust badges.&lt;br&gt;&amp;bull; &lt;i&gt;Note: Represents email ownership confirmation, not medical certification.&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;shadow=0;arcSize=4;spacing=6;" vertex="1" parent="layer-firebase">
          <mxGeometry x="15" y="770" width="440" height="95" as="geometry" />
        </mxCell>

        <!-- Firebase Arch Tag -->
        <mxCell id="fb-tech-badge" value="&lt;b style=&quot;font-size:10px; color:#334155;&quot;&gt;Backend Infrastructure:&lt;/b&gt; Firebase Spark Plan &amp;bull; Zero Cloud Functions &amp;bull; Zero Paid Gateways" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#CBD5E1;arcSize=4;spacing=4;" vertex="1" parent="layer-firebase">
          <mxGeometry x="15" y="875" width="440" height="28" as="geometry" />
        </mxCell>

        <!-- ==================== LAYER 4: EXTERNAL SERVICES ==================== -->
