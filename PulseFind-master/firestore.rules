rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Prevents client modification of security/verification fields
    function hasNoProtectedFieldModifications() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'phoneVerified',
        'emailVerified',
        'role',
        'verificationMethod',
        'verifiedAt'
      ]);
    }

    // USERS COLLECTION
    match /users/{userId} {
      allow read: if true;
      
      // Client can create initial profile only without verified flags or with unverified flags
      allow create: if isOwner(userId)
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified == false)
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == false)
        && !('verifiedAt' in request.resource.data);
        
      // Client can update non-sensitive profile details (name, area, phone, etc.), but NOT verified flags or role
      allow update: if isOwner(userId) && hasNoProtectedFieldModifications();
      
      allow delete: if false;
    }

    // PHARMACIES COLLECTION
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      
      allow create: if isOwner(pharmacyId)
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified == false)
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == false)
        && !('verifiedAt' in request.resource.data);
        
      allow update: if isOwner(pharmacyId) && hasNoProtectedFieldModifications();
      
      allow delete: if false;
    }

    // DONORS COLLECTION
    match /donors/{donorId} {
      allow read: if true;
      
      allow create: if isOwner(donorId)
        && (!('phoneVerified' in request.resource.data) || request.resource.data.phoneVerified == false)
        && (!('emailVerified' in request.resource.data) || request.resource.data.emailVerified == false)
        && !('verifiedAt' in request.resource.data);
        
      allow update: if isOwner(donorId) && hasNoProtectedFieldModifications();
      
      allow delete: if false;
    }

    // INVENTORY COLLECTION
    match /inventory/{itemId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.pharmacyId == request.auth.uid;
      allow update, delete: if isAuthenticated() && resource.data.pharmacyId == request.auth.uid;
    }

    // BLOOD REQUESTS & RESPONSES
    match /blood_requests/{reqId} {
      allow read, create: if true;
      allow update: if isAuthenticated();
      
      match /responses/{donorUid} {
        allow read: if true;
        allow write: if isOwner(donorUid);
      }
    }
  }
}